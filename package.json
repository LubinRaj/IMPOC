{
  "name": "impoc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname localhost --port 3000",
    "build": "next build",
    "start": "next start --hostname localhost --port 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:prepare && vitest run",
    "test:prepare": "tsx scripts/prepare-test-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/server/db/seed.ts",
    "worker": "node scripts/sync-worker.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1152.0",
    "@azure/identity": "^4.14.0",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.3.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
