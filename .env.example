DATABASE_URL=postgres://inventory:inventory_local@127.0.0.1:55439/inventory
APP_PASSCODE=replace-with-six-digit-passcode
APP_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SOURCE_MODE=simulation
SYNC_WORKER_SECRET=replace-with-a-random-secret-at-least-24-characters
EVENT_INGEST_SECRET=replace-with-a-different-random-secret-at-least-24-characters
SYNC_POLL_SECONDS=300
# LIVE_SCOPE_CONFIG_JSON maps provider scope UUIDs to provider-specific connection settings.
# LIVE_SCOPE_CONFIG_JSON={"scope-uuid":{"region":"us-east-1"}}
# AWS uses the SDK default credential chain; Azure uses DefaultAzureCredential; GCP uses Application Default Credentials.
# VMWARE_USERNAME=readonly-user
# VMWARE_PASSWORD=replace-me
# PROXMOX_TOKEN_ID=user@pve!inventory
# PROXMOX_TOKEN_SECRET=replace-me
# scripts/setup-netbox.sh adds a generated NETBOX_URL and NETBOX_API_TOKEN here.
# ENABLE_LOCAL_INVENTORY_TEST_ADAPTER=true enables the legacy local inventory API only for isolated tests.
